# Environment Configuration Template
# Copy this file to .env and adjust variables as needed. Do NOT commit .env to Git!

CHURN_PROJECT_NAME="Customer Churn Prediction"
CHURN_VERSION="1.0.0"
CHURN_DEBUG=False

# Server Configuration
CHURN_API_HOST=0.0.0.0
CHURN_API_PORT=8000

# MLflow Tracking (Local filesystem by default)
MLFLOW_TRACKING_URI="file:./mlruns"
CHURN_MLFLOW_EXPERIMENT_NAME="churn-prediction-xgboost"

# Optional Cloud Deployment Deploy Hook / API Secrets
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxx?key=yyyy
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
